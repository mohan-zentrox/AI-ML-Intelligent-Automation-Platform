# Project Synapse - environment configuration
# Copy to .env and adjust. Everything below has a safe zero-dependency
# default baked into backend/app/core/config.py - you do not need to set
# anything to run the backend locally with `uvicorn app.main:app --reload`.

# --- General ---
ENVIRONMENT=local
DEBUG=true

# --- Security (CHANGE IN ANY REAL DEPLOYMENT) ---
SECRET_KEY=dev-only-insecure-secret-change-me

# --- Database ---
# Local dev / CI default (zero-dependency):
DATABASE_URL=sqlite:///./synapse_local.db
# docker-compose overrides this to Postgres automatically - see docker-compose.yml.
# DATABASE_URL=postgresql+psycopg2://synapse:synapse_local_dev_only@localhost:5432/synapse

# --- Vector store ---
# inmemory = zero-dependency pure-python cosine similarity (default)
# chroma   = persistent ChromaDB (requires `pip install chromadb`)
VECTOR_STORE_BACKEND=inmemory
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=synapse_chunks

# --- LLM / embedding provider ---
# mock    = deterministic local provider, zero external calls, zero cost (default)
# litellm = real multi-provider routing via LiteLLM (needs an API key below)
LLM_PROVIDER=mock
LITELLM_MODEL=gpt-4o-mini
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
LITELLM_FALLBACK_MODELS=

# Only needed when LLM_PROVIDER=litellm - set whichever vendor key(s) your
# chosen LITELLM_MODEL requires (see https://docs.litellm.ai/docs/providers).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- RAG behaviour ---
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.15
REVIEW_CONFIDENCE_THRESHOLD=0.55

# --- Document classification (FRD 7) ---
# Auto-classify every ingested document into the taxonomy defined in
# backend/app/services/classification.py. Set false to skip the extra
# provider call per ingest.
CLASSIFICATION_ENABLED=true
# Only the first N characters of a document are sent to the classifier.
CLASSIFICATION_SAMPLE_CHARS=4000
# Below this confidence the label is provisional and the document is queued
# for human confirmation instead of being trusted for routing.
CLASSIFICATION_REVIEW_THRESHOLD=0.55

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
