# Project Synapse - environment configuration
# Copy to .env and adjust. Everything below has a safe zero-dependency
# default baked into backend/app/core/config.py - you do not need to set
# anything to run the backend locally with `uvicorn app.main:app --reload`.

# --- General ---
# Keep this as "local" only for local development. Any other value switches on
# the deployment safety checks in backend/app/core/config.py: the placeholder
# SECRET_KEY below is then rejected at startup, and the demo roster is not
# seeded.
ENVIRONMENT=local
DEBUG=false

# --- Security (CHANGE IN ANY REAL DEPLOYMENT) ---
# Signs JWTs AND HMACs the stored API-key hashes, so a known value is a full
# auth bypass - anyone can mint an admin token. This placeholder is published
# in the repo and the app REFUSES TO START with it unless ENVIRONMENT=local.
# Generate a real one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# --- Demo users ---
# Seeds the six T6-* accounts from docs/TEAM.md, all sharing the password
# `ChangeMe123!`, which is published in this repo - including an ADMIN account.
# Leave unset: it then resolves to true only when ENVIRONMENT=local. Setting it
# true with ENVIRONMENT != local is rejected at startup.
# SEED_DEMO_USERS=true

# --- Database ---
# Local dev / CI default (zero-dependency):
DATABASE_URL=sqlite:///./synapse_local.db
# docker-compose overrides this to Postgres automatically - see docker-compose.yml.
# DATABASE_URL=postgresql+psycopg2://synapse:synapse_local_dev_only@localhost:5432/synapse

# --- Vector store ---
# pgvector = embeddings in the same Postgres that holds the documents. USE THIS
#            FOR ANY DEPLOYMENT: it is the only backend that survives a restart
#            without a mounted disk. Requires a PostgreSQL DATABASE_URL and the
#            `vector` extension (Neon, Supabase and RDS all ship it; the app
#            creates the extension and table itself on first use).
# chroma   = persistent ChromaDB (requires `pip install -r requirements-optional.txt`
#            AND a persistent directory)
# inmemory = zero-dependency pure-python cosine similarity (default). LOSES
#            EVERY EMBEDDING ON RESTART - the documents stay in the database
#            and keep listing in the UI, but every query refuses because there
#            is nothing left to retrieve. Local dev and tests only.
VECTOR_STORE_BACKEND=inmemory
# Dimensionality of the active embedding model; sizes the pgvector column.
# mock provider = 256, OpenAI text-embedding-3-small = 1536. Changing this
# after documents exist requires re-ingesting them.
EMBEDDING_DIM=256
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=synapse_chunks

# --- LLM / embedding provider ---
# mock    = deterministic local provider, zero external calls, zero cost (default)
# litellm = real multi-provider routing via LiteLLM (needs an API key below)
LLM_PROVIDER=mock
LITELLM_MODEL=gpt-4o-mini
LITELLM_EMBEDDING_MODEL=text-embedding-3-small
LITELLM_FALLBACK_MODELS=

# Only needed when LLM_PROVIDER=litellm - set whichever vendor key(s) your
# chosen LITELLM_MODEL requires (see https://docs.litellm.ai/docs/providers).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- RAG behaviour ---
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.15
REVIEW_CONFIDENCE_THRESHOLD=0.55

# --- Uploads ---
# Hard ceiling on a single uploaded file. Enforced while the request body is
# read, so an oversized upload is rejected with 413 instead of being buffered
# in full first. Default 10 MB (10485760); raise only if you really ingest
# larger documents, and remember a small instance pays for it in RAM.
MAX_UPLOAD_BYTES=10485760

# --- Document classification (FRD 7) ---
# Auto-classify every ingested document into the taxonomy defined in
# backend/app/services/classification.py. Set false to skip the extra
# provider call per ingest.
CLASSIFICATION_ENABLED=true
# Only the first N characters of a document are sent to the classifier.
CLASSIFICATION_SAMPLE_CHARS=4000
# Below this confidence the label is provisional and the document is queued
# for human confirmation instead of being trusted for routing.
CLASSIFICATION_REVIEW_THRESHOLD=0.55

# --- CORS ---
# Origins allowed to call the API. Accepts a comma-separated list or a JSON
# array. A deployed frontend is on a different origin than the API, so this
# must include it or every browser request fails preflight.
# CORS_ORIGINS=https://synapse.pages.dev,http://localhost:5173

# --- Frontend ---
# BUILD-TIME ONLY. Vite inlines VITE_* into the JS bundle during `npm run
# build`, so setting this on a running container does nothing - it has to be
# passed as a Docker build arg (docker-compose.yml wires it up already):
#     docker compose build --build-arg VITE_API_BASE_URL=https://api.example.com/api/v1
# For `npm run dev` a plain frontend/.env.local works, since Vite reads it at
# dev-server start.
VITE_API_BASE_URL=http://localhost:8000/api/v1
